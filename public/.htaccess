# ---------- Padhya Software Technologies – website rules ----------
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Temporary Hostinger domain (*.hostingersite.com): keep it out of Google so it never competes with www.padhyasoft.com
SetEnvIfNoCase Host "hostingersite\.com$" STAGING_HOST
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=STAGING_HOST
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # padhyasoft.com -> www.padhyasoft.com (one address for Google)
  RewriteCond %{HTTP_HOST} ^padhyasoft\.com$ [NC]
  RewriteRule ^(.*)$ https://www.padhyasoft.com/$1 [R=301,L]

  # 301 redirects from the old website's addresses, so their Google rankings move to the new pages
  RewriteRule ^service/?$ /services [R=301,L,NC]
  RewriteRule ^(softwaredevelopment|mobileappdevelopment|webdevelopment|webdesign|industryautomationsolutions|digitalmarketing|qrcodesolution|trackandtracesystem|videoeditingservices|graphicdesignservices|ecommercesystem)/?$ /service/$1 [R=301,L,NC]
  RewriteRule ^consultation/?$ /contact [R=301,L,NC]
  RewriteRule ^(about|services|contact|blogs|privacy-policy|terms-and-conditions)/$ /$1 [R=301,L,NC]

  # pre-rendered pages: /about -> about.html, /service/x -> service/x.html, /blog/x -> blog/x.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
